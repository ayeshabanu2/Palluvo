# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication & Mailbox Verification Requirements
# Set to 'true' if your Supabase project enforces "Confirm email" in Auth settings (https://supabase.com/docs/guides/auth/general-configuration#email-provider)
# When true, authenticated sessions with confirmed mailboxes enforce shared email rate quotas.
# When false (or disabled in Supabase), shared email quotas are not applied to prevent quota poisoning via unconfirmed signups.
REQUIRE_EMAIL_CONFIRMATION=true

